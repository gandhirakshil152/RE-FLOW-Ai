# RE-FLOW AI Environment Variables

# Project Settings
PROJECT_NAME="RE-FLOW AI"
API_V1_STR="/api"
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Database Configuration (PostgreSQL / TimescaleDB)
# Leave blank or set to sqlite:///./reflow.db for zero-config local demo mode
DATABASE_URL=sqlite:///./reflow.db
# For production PostgreSQL / TimescaleDB:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reflow_ai

# Default Location Coordinates (Gandhinagar / Ahmedabad Clean Energy Hub)
DEFAULT_LATITUDE=23.2156
DEFAULT_LONGITUDE=72.6369

# Facility Energy Baseline Constants
FACILITY_BASE_LOAD_KW=350.0
FACILITY_SOLAR_CAPACITY_KW=1200.0
FACILITY_WIND_CAPACITY_KW=200.0

# Grid Emissions Factor (kg CO2 per kWh)
GRID_EMISSION_FACTOR_KG_PER_KWH=0.72

# Electricity Tariff Rates ($ / kWh or ₹ / kWh)
TARIFF_OFF_PEAK=0.08
TARIFF_MID_PEAK=0.14
TARIFF_PEAK=0.28
